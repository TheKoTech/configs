//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette

{
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "default",
        "effort": "medium",
        "model": "sonnet"
      },
      "type": "registry"
    }
  },
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left",
  },

  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "auto_update_extensions": {
    "scss": false,
  },
  "show_edit_predictions": false,
  "minimap": {
    "show": "always",
    "display_in": "all_editors",
  },
  "ssh_connections": [
    {
      "host": "tiwi",
      "args": [],
      "projects": [
        {
          "paths": ["/home/syn/services"],
        },
      ],
    },
    {
      "host": "momseafile",
      "args": [],
      "projects": [
        {
          "paths": ["/home/welnyr/services"],
        },
        {
          "paths": ["/tank/seafile"],
        },
      ],
    },
  ],

  "agent": {
    "notify_when_agent_waiting": "all_screens",
    "dock": "right",
    "sidebar_side": "right",
    "default_profile": "minimal",
    "flexible": false,
    "default_width": 800,
    "use_modifier_to_send": true,
    "model_parameters": [],
  },

  "languages": {
    "Rust": {
      "tab_size": 4,
    },
    "Python": {
      "tab_size": 4,
    },
    "QML": {
      "tab_size": 4,
    },
  },

  "git_panel": {
    "dock": "right",
  },
  "icon_theme": {
    "mode": "dark",
    "light": "VSCode Icons for Zed (Dark)",
    "dark": "VSCode Icons for Zed (Dark)",
  },
  "autosave": "on_focus_change",
  "show_completions_on_input": true,

  "edit_predictions": {
    "mode": "subtle",
    "disabled_globs": ["*"],
    "allow_data_collection": "no",
  },

  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true,
    "use_system_clipboard": "on_yank",
    "cursor_shape": {
      "visual": "underline"
    }
  },

  "ui_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "buffer_line_height": { "custom": 1.6 },
  "ensure_final_newline_on_save": false,
  "extend_comment_on_newline": false,
  "buffer_font_weight": 300,

  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Sublime Material Dark",
  },
  "auto_update": false,
  "base_keymap": "VSCode",
  "indent_guides": {
    "coloring": "indent_aware",
  },
  "tab_size": 2,
}
