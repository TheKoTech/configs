//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette

{
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "fast": true,
        "mode": "default",
        "model": "sonnet",
      },
      "type": "registry",
    },
  },

  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left",
  },

  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "auto_update_extensions": {
    "scss": false,
  },
  "show_edit_predictions": false,
  "minimap": {
    "show": "always",
    "display_in": "all_editors",
  },
  "ssh_connections": [
    {
      "host": "tiwi",
      "args": [],
      "projects": [
        {
          "paths": ["/home/syn/services"],
        },
      ],
    },
    {
      "host": "momseafile",
      "args": [],
      "projects": [
        {
          "paths": ["/home/welnyr/services"],
        },
        {
          "paths": ["/tank/seafile"],
        },
      ],
    },
  ],

  "agent": {
    "dock": "right",
    "sidebar_side": "left",
    "default_profile": "minimal",
    "flexible": false,
    "use_modifier_to_send": true,
    "inline_assistant_model": {
      "provider": "openai",
      "model": "google/gemini-3.1-flash-lite-thinking",
    },
    "model_parameters": [],
    "default_model": {
      "enable_thinking": false,
      "provider": "openai",
      "model": "google/gemini-3.5-flash-lite-minimal",
    },
  },

  "languages": {
    "Rust": {
      "tab_size": 4,
    },
    "Python": {
      "tab_size": 4,
    },
  },

